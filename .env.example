# Supabase (same project as Flutter app — ref wabtknktqnrxnffkgpzh)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (required for admin login when profile id is out of sync)
# Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: used for auth email redirects in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend transactional email (server-only)
RESEND_API_KEY=
EMAIL_FROM=WTVA <notifications@wherethevibesat.com>

# Firebase Cloud Messaging (server-only) — Message Center "Push to phone"
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value; keep \n escapes or use real newlines in quotes
FIREBASE_PRIVATE_KEY=

# Optional: Stripe secret key for platform balance payouts from /earnings/withdraw
# Use the same platform secret key as the customer app (server-only)
STRIPE_SECRET_KEY=

# Admin → business "Login as owner". Must match business portal IMPERSONATION_SECRET.
# If unset, falls back to SUPABASE_SERVICE_ROLE_KEY (set the same value on both apps).
IMPERSONATION_SECRET=
